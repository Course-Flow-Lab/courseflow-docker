# Set the exact browser origin. Use your HTTPS URL behind a reverse proxy.
PUBLIC_URL=http://127.0.0.1:8100
WEB_PORT=8100
PROJECT_NAME=courseflow-docker
# Default private local state: /path/to/workspace/docker-state.
# On a remote server keep deployment files and data together under /path/to/courseflow/.
# STATE_DIR=/path/to/courseflow/state
